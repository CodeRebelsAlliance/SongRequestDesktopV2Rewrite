<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>SRshortLogo.ico</ApplicationIcon>
    <Platforms>AnyCPU;x64</Platforms>
    <AssemblyName>SongRequest V2</AssemblyName>
    <StartupObject>SongRequestDesktopV2Rewrite.Program</StartupObject>

    <!--
      The product version lives in Directory.Build.props (one value for the
      desktop app, the shared core and the mobile app alike).
    -->

    <!-- Product metadata (Windows file properties, Apps & features entry). -->
    <AssemblyTitle>SongRequest Desktop</AssemblyTitle>
    <Product>SongRequest Desktop</Product>
    <Company>CodeRebelsAlliance UG</Company>
    <Copyright>Copyright © CodeRebelsAlliance UG</Copyright>
    <Description>Song request queue, soundboard and playback for live events.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Desktop-only backends. Everything platform-neutral lives in SongRequest.Core. -->
    <PackageReference Include="Photino.Native" Version="4.0.22" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <PackageReference Include="Photino.NET.Server" Version="4.0.12" />
    <PackageReference Include="RtMidi.Core" Version="1.0.53" GeneratePathProperty="true" />
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <PackageReference Include="Tmds.DBus" Version="0.95.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SongRequest.Core\SongRequest.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="SRshortLogo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="SRappIcon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="LargeSR.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="announcement.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="newui\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--
      The pages load `_framework/hybridwebview.js` (the .NET MAUI HybridWebView
      shim) so one set of markup serves desktop and mobile. On mobile the control
      serves the real script; the desktop ships this empty stub so the tag does
      not 404 in the web view's console.
    -->
    <Content Include="hybridwebview-stub.js">
      <Link>newui\_framework\hybridwebview.js</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    The pages reference their images relative to newui/ (so the same tree works
    both in the desktop output and inside the mobile app's web assets), which
    means the copies in newui/ are published as part of the glob above.
  -->

  <!-- RtMidi.Core's bundled targets omit the Linux native library; copy it so MIDI works. -->
  <ItemGroup Condition="Exists('$(PkgRtMidi_Core)/build/librtmidi.so')">
    <None Include="$(PkgRtMidi_Core)/build/librtmidi.so">
      <Link>librtmidi.so</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SongRequestDesktopV2Rewrite.UnitTests" />
    <InternalsVisibleTo Include="SongRequestDesktopV2Rewrite.IntegrationTests" />
  </ItemGroup>

  <!--
    Windows SMTC backend: the WinRT/CsWinRT implementation lives in a Windows-only
    companion assembly (net10.0-windows10.0.19041.0) that is loaded at runtime by
    Platform/Media/WindowsSmtcLoader.cs. Publishing it next to the app for win-*
    RIDs keeps the main app a single cross-platform net10.0 assembly.
    See docs/SYSTEM-MEDIA-INTEGRATION.md.
  -->
  <Target Name="PublishWindowsSmtcCompanion"
          AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' != '' And $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win'))">
    <PropertyGroup>
      <_SmtcCompanionProject>$(MSBuildProjectDirectory)/../SongRequestDesktopV2Rewrite.Smtc.Windows/SongRequestDesktopV2Rewrite.Smtc.Windows.csproj</_SmtcCompanionProject>
      <_SmtcCompanionPublishDir Condition="$([System.IO.Path]::IsPathRooted('$(PublishDir)'))">$(PublishDir)</_SmtcCompanionPublishDir>
      <_SmtcCompanionPublishDir Condition="'$(_SmtcCompanionPublishDir)' == ''">$(MSBuildProjectDirectory)/$(PublishDir)</_SmtcCompanionPublishDir>
    </PropertyGroup>

    <MSBuild Projects="$(_SmtcCompanionProject)"
             Targets="Restore;Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishSingleFile=false;PublishDir=$(_SmtcCompanionPublishDir)" />
  </Target>

</Project>
