<?xml version="1.0" encoding="utf-8"?>
<!--
  Test-run settings shared by local runs (tests/run-tests.sh) and CI.

  Environment:
    ALSOFT_DRIVERS=null — makes OpenAL Soft use its null output backend, so the
    audio integration tests run on headless machines/CI runners that have no sound
    card. This is applied by the test host *before* the test assembly is loaded,
    which is the only place that is guaranteed to win over an already-loaded native
    library (a [ModuleInitializer] cannot guarantee that on every runner).

  Coverage:
    Native platform shells and the GUI shell that cannot run headless are excluded
    from the coverage numbers (they are compile-checked; their pure pieces are
    unit-tested separately):
      - Win32TrayIcon / LinuxTrayIcon: tray P/Invoke (Windows; Linux needs a GTK
        display + tray host; the AppIndicator binding is symbol-tested).
      - WindowsGlobalHotkeyBackend / X11GlobalHotkeyBackend: global-hotkey P/Invoke
        (need a desktop session); the gesture/key-table/service logic is tested.
      - NewUiWindow: creates Photino windows (needs a display + a webview), so it
        cannot run headless; `TrayMenu` and the window geometry/icon decisions it
        uses are unit-tested.
      - The Windows SMTC companion and the Windows "Apps & features" registration
        are Windows-only; their pure parts are unit-tested.
-->
<RunSettings>
  <RunConfiguration>
    <EnvironmentVariables>
      <ALSOFT_DRIVERS>null</ALSOFT_DRIVERS>
    </EnvironmentVariables>
  </RunConfiguration>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
          <ExcludeByFile>**/Platform/Win32TrayIcon.cs,**/Platform/LinuxTrayIcon.cs,**/Platform/Hotkeys/WindowsGlobalHotkeyBackend.cs,**/Platform/Hotkeys/X11GlobalHotkeyBackend.cs,**/NewUiWindow.cs</ExcludeByFile>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
